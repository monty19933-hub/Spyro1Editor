<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/Brand/app-icon.ico</ApplicationIcon>
    <AssemblyName>Spyro.Editor.App</AssemblyName>
    <RootNamespace>Spyro.Editor.App</RootNamespace>
    <!--
      BetaReleaseNumber is the legacy integer identity consumed by Beta V2's
      updater. Keep it for whole-number compatibility bridges and for the
      legacy SpyroEditorBetaRelease assembly metadata below.

      PublicReleaseVersion is the canonical release identity. Whole-number
      compatibility bridges such as V4 use schema 1 so installed legacy
      clients can discover them. Incremental releases use schema 2 and dotted
      values such as "4.1" while retaining the bridge's legacy major.
    -->
    <BetaReleaseNumber>4</BetaReleaseNumber>
    <PublicReleaseVersion>4</PublicReleaseVersion>
    <ReleaseManifestSchemaVersion>1</ReleaseManifestSchemaVersion>
    <PreviousPublicReleaseVersion>3</PreviousPublicReleaseVersion>
    <Version>0.1.0-beta.31</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0-beta.31</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Spyro Editor Beta V$(PublicReleaseVersion)</Product>
    <Description>Spyro Editor Beta V$(PublicReleaseVersion)</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="SpyroEditorBetaRelease" Value="$(BetaReleaseNumber)" />
    <AssemblyMetadata Include="SpyroEditorPublicReleaseVersion" Value="$(PublicReleaseVersion)" />
    <AssemblyMetadata Include="SpyroEditorReleaseManifestSchema" Value="$(ReleaseManifestSchemaVersion)" />
    <InternalsVisibleTo Include="Spyro.Editor.UiSmoke" />
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <ProjectReference Include="../Spyro.Editor.Core/Spyro.Editor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../spyro-level-catalog.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../spyro-object-templates.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-moby-user-overrides.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-live-validation-overrides.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-behavior-links.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets/Brand/app-icon.png" />
    <AvaloniaResource Include="Assets/Brand/spyro-editor-title.png" />
    <AvaloniaResource Include="Assets/SkyPresets/*.png" />
    <Content Include="Assets/MobyIcons/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/app-icon.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
