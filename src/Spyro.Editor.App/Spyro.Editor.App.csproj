<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/Brand/app-icon.ico</ApplicationIcon>
    <AssemblyName>Spyro.Editor.App</AssemblyName>
    <RootNamespace>Spyro.Editor.App</RootNamespace>
    <!--
      BetaReleaseNumber is the legacy integer identity consumed by Beta V2's
      updater. Keep it for whole-number compatibility bridges and for the
      legacy SpyroEditorBetaRelease assembly metadata below.

      PublicReleaseVersion is the legacy beta channel identity. Stable releases use
      StableReleaseVersion and schema 3 in a separate updater channel. Whole-number
      compatibility bridges such as V5 use schema 1 so installed legacy
      clients can discover them. Incremental releases use schema 2 and dotted
      values such as "5.1" while retaining the bridge's legacy major.
    -->
    <ReleaseChannel Condition="'$(ReleaseChannel)' == ''">stable</ReleaseChannel>
    <BetaReleaseNumber>6</BetaReleaseNumber>
    <PublicReleaseVersion>6</PublicReleaseVersion>
    <ReleaseManifestSchemaVersion>1</ReleaseManifestSchemaVersion>
    <PreviousPublicReleaseVersion>5</PreviousPublicReleaseVersion>
    <StableReleaseVersion Condition="'$(StableReleaseVersion)' == ''">1.0.10</StableReleaseVersion>
    <PreviousStableReleaseVersion>1.0.9</PreviousStableReleaseVersion>
    <LegacyBetaInternalVersion>0.1.0-beta.54</LegacyBetaInternalVersion>
    <Version>1.0.10</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Spyro Editor Beta V$(PublicReleaseVersion)</Product>
    <Description>Spyro Editor Beta V$(PublicReleaseVersion)</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ReleaseChannel)' == 'beta'">
    <Version>$(LegacyBetaInternalVersion)</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ReleaseChannel)' == 'stable'">
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <Product>Spyro Editor $(StableReleaseVersion)</Product>
    <Description>Spyro Editor $(StableReleaseVersion)</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(ReleaseChannel)' == 'stable'">
    <AssemblyMetadata Include="SpyroEditorReleaseChannel" Value="stable" />
    <AssemblyMetadata Include="SpyroEditorStableReleaseVersion" Value="$(StableReleaseVersion)" />
    <AssemblyMetadata Include="SpyroEditorStableManifestSchema" Value="3" />
  </ItemGroup>
  <Target Name="ValidateReleaseChannel" BeforeTargets="GenerateAssemblyInfo">
    <Error Condition="'$(ReleaseChannel)' != 'beta' and '$(ReleaseChannel)' != 'stable'" Text="ReleaseChannel must be beta or stable." />
    <Error Condition="'$(ReleaseChannel)' == 'stable' and '$(StableReleaseVersion)' == ''" Text="StableReleaseVersion must be explicitly supplied for a stable build." />
  </Target>

  <ItemGroup>
    <AssemblyMetadata Include="SpyroEditorBetaRelease" Value="$(BetaReleaseNumber)" />
    <AssemblyMetadata Include="SpyroEditorPublicReleaseVersion" Value="$(PublicReleaseVersion)" />
    <AssemblyMetadata Include="SpyroEditorReleaseManifestSchema" Value="$(ReleaseManifestSchemaVersion)" />
    <InternalsVisibleTo Include="Spyro.Editor.UiSmoke" />
    <InternalsVisibleTo Include="Spyro.Editor.AppendedPrivateTerrainPromotionGateSmoke" />
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <ProjectReference Include="../Spyro.Editor.Core/Spyro.Editor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../spyro-level-catalog.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../spyro-object-templates.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-moby-user-overrides.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-live-validation-overrides.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <Content Include="../../*-behavior-links.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets/Brand/app-icon.png" />
    <AvaloniaResource Include="Assets/Brand/spyro-editor-title.png" />
    <AvaloniaResource Include="Assets/SkyPresets/*.png" />
    <Content Include="Assets/MobyIcons/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/ObjectGalleryIcons/*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/app-icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/app-icon.icns" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
