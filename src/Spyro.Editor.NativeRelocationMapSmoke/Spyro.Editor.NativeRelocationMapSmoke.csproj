<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FrozenCorePath)' != ''">
    <DefineConstants>$(DefineConstants);FROZEN_CORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FrozenCorePath)' != ''">
    <Compile Remove="MapCases.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrozenCorePath)' == ''">
    <ProjectReference Include="../Spyro.Editor.Core/Spyro.Editor.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(FrozenCorePath)' != ''">
    <Reference Include="Spyro.Editor.Core"><HintPath>$(FrozenCorePath)</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Spyro.Editor.WadGrowthGapSmoke/GapFixture.cs" Link="NestedGrowthDiscFixture.cs" />
  </ItemGroup>
</Project>
